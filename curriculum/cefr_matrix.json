  "exercise_policy": {
    "minimum_items_per_concept": 5,
    "required_item_families": [
      "form_meaning_recognition",
      "contextual_completion",
      "brazilian_error_correction",
      "transformation_or_reformulation",
      "communicative_production"
    ],
    "advanced_contextual_item_ratio": {
      "B1": 0.4,
      "B2": 0.4
    }
  },
  "mastery_policy": {
    "minimum_correct_evidence": 3,
    "minimum_distinct_sessions": 2,
    "requires_productive_evidence": true,
    "minimum_recent_accuracy": {
      "A1": 0.8,
      "A2": 0.8,
      "B1": 0.75,
      "B2": 0.75
    },
    "requires_delayed_retention_check": true,
    "global_level_is_simple_average": false
  }
}

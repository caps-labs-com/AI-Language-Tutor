{
  "schema_version": "1.0.0",
  "curriculum_version": "2026-08-10",
  "audience": "adult Brazilian Portuguese speakers",
  "languages": ["en", "es", "fr", "it"],
  "levels": ["A1", "A2", "B1", "B2"],
  "authority": {
    "common_framework": "CEFR Companion Volume 2020",
    "language_specific": {
      "en": ["Cambridge English", "English Profile"],
      "es": ["Plan Curricular del Instituto Cervantes"],
      "fr": ["France Education international CEFR linguistic inventory"],
      "it": ["Profilo della lingua italiana A1-B2", "CILS guidelines"]
    },
    "note": "CEFR descriptors are authoritative capability references; topic order and editorial limits are Lume curriculum decisions."
  },
  "common": {
    "themes": [
      "identity_relationships_daily_life",
      "home_neighborhood_city_mobility",
      "food_shopping_services",
      "health_wellbeing_emergencies",
      "education_work_career",
      "travel_accommodation_interculturality",
      "leisure_culture_media_technology",
      "nature_weather_sustainability",
      "society_citizenship_human_relations",
      "opinions_decisions_projects_problem_solving"
    ],
    "levels": {
      "A1": {
        "global_outcome": "Meet immediate concrete needs with basic expressions and cooperative support.",
        "functions": [
          "greet_and_close",
          "introduce_self_and_others",
          "exchange_personal_information",
          "state_likes_abilities_possession_and_location",
          "ask_price_time_quantity_and_direction",
          "make_basic_requests",
          "understand_short_instructions",
          "describe_people_objects_places_and_routines"
        ],
        "skills": {
          "reading": "Understand short predictable notices, menus, forms, messages and descriptions.",
          "listening": "Understand slow clear speech about personal details and immediate needs.",
          "spoken_production": "Produce isolated or linked simple phrases about self and concrete needs.",
          "written_production": "Complete forms and write very short messages and descriptions.",
          "interaction": "Ask and answer simple questions when the interlocutor helps.",
          "mediation": "Relay names, numbers, times and very simple practical information."
        },
        "content_limits": {
          "reading_words_min": 100,
          "reading_words_max": 180,
          "paragraphs_min": 2,
          "paragraphs_max": 3,
          "questions_min": 3,
          "questions_max": 4,
          "writing_words_min": 30,
          "writing_words_max": 60,
          "audio_seconds_min": 30,
          "audio_seconds_max": 60,
          "new_lexical_items_min": 8,
          "new_lexical_items_max": 12
        },
        "assessment_tasks": [
          "complete_personal_form",
          "understand_notice_or_menu",
          "exchange_personal_details",
          "write_short_practical_message",
          "follow_short_directions"
        ]
      },
      "A2": {
        "global_outcome": "Handle routine exchanges and describe background, environment and immediate needs.",
        "functions": [
          "report_simple_events",
          "arrange_meetings",
          "invite_accept_and_refuse",
          "compare_options",
          "express_reason_frequency_and_quantity",
          "request_clarification_and_confirmation",
          "give_sequenced_instructions",
          "book_buy_complain_and_request"
        ],
        "skills": {
          "reading": "Understand short emails, advertisements, instructions and predictable narratives.",
          "listening": "Understand short messages and routine conversations on familiar matters.",
          "spoken_production": "Give a simple series of phrases about routines, past events and plans.",
          "written_production": "Write linked notes, emails and descriptions on familiar topics.",
          "interaction": "Complete routine tasks involving direct exchange of information.",
          "mediation": "Select and relay relevant points from short concrete texts."
        },
        "content_limits": {
          "reading_words_min": 180,
          "reading_words_max": 320,
          "paragraphs_min": 3,
          "paragraphs_max": 4,
          "questions_min": 4,
          "questions_max": 5,
          "writing_words_min": 70,
          "writing_words_max": 120,
          "audio_seconds_min": 60,
          "audio_seconds_max": 120,
          "new_lexical_items_min": 10,
          "new_lexical_items_max": 16
        },
        "assessment_tasks": [
          "understand_routine_email",
          "describe_recent_event",
          "make_and_change_booking",
          "write_invitation_or_request",
          "give_simple_advice"
        ]
      },
      "B1": {
        "global_outcome": "Handle most familiar situations and produce connected language with reasons and explanations.",
        "functions": [
          "narrate_with_sequence_context_and_result",
          "explain_plans_intentions_causes_and_consequences",
          "state_and_support_opinion",
          "summarize_straightforward_content",
          "report_another_persons_speech",
          "resolve_common_unexpected_problems",
          "agree_disagree_and_negotiate_politely"
        ],
        "skills": {
          "reading": "Understand straightforward articles and narratives on familiar or current topics.",
          "listening": "Understand main points of clear standard speech and organized media.",
          "spoken_production": "Connect ideas to narrate, explain, compare and justify opinions.",
          "written_production": "Write connected texts about experiences, plans and opinions.",
          "interaction": "Sustain familiar conversation and solve most travel and service situations.",
          "mediation": "Summarize main points and explain familiar information to others."
        },
        "content_limits": {
          "reading_words_min": 400,
          "reading_words_max": 700,
          "paragraphs_min": 5,
          "paragraphs_max": 7,
          "questions_min": 5,
          "questions_max": 6,
          "writing_words_min": 140,
          "writing_words_max": 220,
          "audio_seconds_min": 120,
          "audio_seconds_max": 240,
          "new_lexical_items_min": 12,
          "new_lexical_items_max": 20
        },
        "assessment_tasks": [
          "summarize_article_or_interview",
          "narrate_experience_with_detail",
          "solve_travel_or_service_problem",
          "write_supported_opinion",
          "present_weekly_plan"
        ]
      },
      "B2": {
        "global_outcome": "Interact with relative fluency and produce detailed argument on concrete and abstract topics.",
        "functions": [
          "build_and_support_argument",
          "compare_perspectives_benefits_risks_and_consequences",
          "reformulate_synthesize_and_clarify",
          "negotiate_solution_and_manage_disagreement",
          "adjust_register_certainty_politeness_and_emphasis",
          "participate_in_interviews_meetings_and_structured_discussion"
        ],
        "skills": {
          "reading": "Understand articles, reports and narratives containing viewpoint, nuance and complex structure.",
          "listening": "Follow extended speech and argument in a range of genres at controlled natural pace.",
          "spoken_production": "Give clear detailed discourse and defend a viewpoint with supporting points.",
          "written_production": "Write detailed structured texts appropriate to genre, audience and purpose.",
          "interaction": "Participate actively, clarify, challenge and negotiate with relative spontaneity.",
          "mediation": "Synthesize perspectives and make complex information accessible."
        },
        "content_limits": {
          "reading_words_min": 650,
          "reading_words_max": 1000,
          "paragraphs_min": 5,
          "paragraphs_max": 8,
          "questions_min": 6,
          "questions_max": 7,
          "writing_words_min": 220,
          "writing_words_max": 350,
          "audio_seconds_min": 180,
          "audio_seconds_max": 360,
          "new_lexical_items_min": 15,
          "new_lexical_items_max": 24
        },
        "assessment_tasks": [
          "evaluate_multiple_viewpoints",
          "defend_proposal_in_discussion",
          "write_formal_or_analytical_text",
          "synthesize_two_sources",
          "negotiate_complex_solution"
        ]
      }
    }
  },

APP_ENV=development
APP_ALLOWED_ORIGINS=http://localhost:3000,https://ai-language-tutor.caps-labs.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=

# Provedores usados por qualquer tarefa que não tenha configuração própria.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=deepseek
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=30
LLM_MAX_COST_PER_REQUEST_USD=0.02

# Configuração por tarefa. Deixe a lista de provedores vazia para herdar
# LLM_PRIMARY_PROVIDER e LLM_FALLBACK_PROVIDERS.
LLM_TUTOR_REPLY_PROVIDERS=
LLM_PREMIUM_TUTOR_REPLY_PROVIDERS=deepseek,gemini
LLM_TUTOR_REPLY_MAX_OUTPUT_TOKENS=1024
LLM_TUTOR_REPLY_TEMPERATURE=0.3

LLM_SESSION_SUMMARY_PROVIDERS=
LLM_SESSION_SUMMARY_MAX_OUTPUT_TOKENS=900
LLM_SESSION_SUMMARY_TEMPERATURE=0.2
LLM_SESSION_SUMMARY_MAX_COST_USD=0.04
LLM_TRANSLATION_PROVIDERS=
LLM_TRANSLATION_MAX_OUTPUT_TOKENS=600
LLM_TRANSLATION_MAX_COST_USD=0.005
LLM_SPEECH_TRANSCRIPTION_MAX_COST_USD=0.01
SPEECH_MAX_AUDIO_BYTES=500000

# Text-to-speech (Premium)
SPEECH_SYNTHESIS_ENABLED=true
SPEECH_SYNTHESIS_PROVIDER=google_standard
SPEECH_SYNTHESIS_MAX_TEXT_LENGTH=500
SPEECH_SYNTHESIS_MAX_COST_USD=0.005
SPEECH_SYNTHESIS_CACHE_VERSION=2026-08-02-v1
SPEECH_SYNTHESIS_MEMORY_CACHE_SIZE=64
SPEECH_SYNTHESIS_USD_PER_MILLION_CHARACTERS=4.0
# Optional local override. Cloud Run uses Application Default Credentials.
GOOGLE_ACCESS_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.28

# Confira os preços antes de mudar o modelo:
# https://ai.google.dev/gemini-api/docs/pricing
# Em produção, use uma chave de um projeto com faturamento ativo e restrinja-a
# à Gemini API. Nunca exponha esta chave no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_INPUT_USD_PER_MILLION=0.25
GEMINI_OUTPUT_USD_PER_MILLION=1.50

# Asaas (assinaturas Premium)
ASAAS_BILLING_ENABLED=false
ASAAS_API_KEY=
ASAAS_WEBHOOK_ACCESS_TOKEN=
ASAAS_ENVIRONMENT=sandbox
ASAAS_MOCK_CHECKOUT=true
BILLING_SITE_URL=http://localhost:3000/
RESEND_API_KEY=
BILLING_EMAIL_FROM=Lume Tutor <noreply@caps-labs.com>

# Mercado Pago (legado — desativado após migração Asaas)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BILLING_ENABLED=false
MERCADOPAGO_MOCK_CHECKOUT=false
MERCADOPAGO_TEST_CHECKOUT=false
MERCADOPAGO_NOTIFICATION_URL=https://your-api.example.com/api/v1/billing/webhook
MERCADOPAGO_BACK_URL=http://localhost:3000/
MERCADOPAGO_MANAGE_URL=https://www.mercadopago.com.br/subscriptions
